<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_employee_form_lucca_connector" model="ir.ui.view">
        <field name="name">hr.employee.form.lucca.connector</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="employee_type" position="after">
                <field name="lucca_id"/>
            </field>
        </field>
    </record>

    <record id="view_employee_tree_lucca_connector" model="ir.ui.view">
        <field name="name">hr.employee.list.lucca.connector</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <field name="work_email" position="after">
                <field name="lucca_id" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
