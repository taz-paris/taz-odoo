<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_industry_view_form_inherit_agreement" model="ir.ui.view">
        <field name="name">res.partner.industry.view.form.inherit.agreement</field>
        <field name="model">res.partner.industry</field>
        <field name="inherit_id" ref="taz-common.res_partner_industry_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_agreements" icon="fa-pencil-square-o">
                    <field string="Marchés / Vecteurs contractuels" name="agreement_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Marchés / Vecteurs contractuels" name="agreements">
                    <field name="agreement_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
