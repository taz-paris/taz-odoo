<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_skill_type_view_form_inherit_napta" model="ir.ui.view">
        <field name="name">hr.skill.type.form.inherit.napta</field>
        <field name="model">hr.skill.type</field>
        <field name="inherit_id" ref="hr_skills.hr_employee_skill_type_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="napta_id" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="hr_skill_type_view_tree_inherit_napta" model="ir.ui.view">
        <field name="name">hr.skill.type.list.inherit.napta</field>
        <field name="model">hr.skill.type</field>
        <field name="inherit_id" ref="hr_skills.hr_skill_type_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="napta_id" readonly="1" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="hr_skill_view_form_inherit_napta" model="ir.ui.view">
        <field name="name">hr.skill.form.inherit.napta</field>
        <field name="model">hr.skill</field>
        <field name="inherit_id" ref="hr_skill_grade.hr_skill_view_form_inherit_hr_skill_grade"/>
        <field name="arch" type="xml">
            <field name="description" position="after">
                <field name="napta_id" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="employee_skill_view_tree_inherit_napta" model="ir.ui.view">
        <field name="name">hr.skill.list.inherit.napta</field>
        <field name="model">hr.skill</field>
        <field name="inherit_id" ref="hr_skill_grade.employee_skill_view_tree_inherit_hr_skill_grade"/>
        <field name="arch" type="xml">
            <field name="is_certification" position="after">
                <field name="napta_id" readonly="1" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="employee_skill_level_view_form_inherit_napta" model="ir.ui.view">
        <field name="name">hr.skill.level.form.inherit.napta</field>
        <field name="model">hr.skill.level</field>
        <field name="inherit_id" ref="hr_skill_grade.employee_skill_level_view_form_inherit_hr_skill_grade"/>
        <field name="arch" type="xml">
            <field name="description" position="after">
                <field name="napta_id" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="employee_skill_level_view_tree_inherit_napta" model="ir.ui.view">
        <field name="name">hr.skill.level.list.inherit.napta</field>
        <field name="model">hr.skill.level</field>
        <field name="inherit_id" ref="hr_skill_grade.employee_skill_level_view_tree_inherit_hr_skill_grade"/>
        <field name="arch" type="xml">
            <field name="description" position="after">
                <field name="napta_id" readonly="1" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="employee_skill_view_form_inherit_napta" model="ir.ui.view">
        <field name="name">hr.employee.skill.form.inherit.napta</field>
        <field name="model">hr.employee.skill</field>
        <field name="inherit_id" ref="hr_skills.employee_skill_view_form"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="napta_id" readonly="1"/>
            </field>
        </field>
    </record>

</odoo>
