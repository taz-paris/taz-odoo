<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_skill_view_form_inherit_hr_skill_grade" model="ir.ui.view">
        <field name="name">hr.skill.form.inherit.hr_skill_grade</field>
        <field name="model">hr.skill</field>
        <field name="inherit_id" ref="hr_skills.hr_skill_view_form"/>
        <field name="arch" type="xml">
            <field name="skill_type_id" position="after">
                <field name="is_certification"/>
                <field name="validity_duration_in_months" invisible="not is_certification"/>
                <field name="description"/>
            </field>
        </field>
    </record>

    <record id="employee_skill_view_tree_inherit_hr_skill_grade" model="ir.ui.view">
        <field name="name">hr.skill.list.inherit.hr_skill_grade</field>
        <field name="model">hr.skill</field>
        <field name="inherit_id" ref="hr_skills.employee_skill_view_tree"/>
        <field name="arch" type="xml">
            <field name="skill_type_id" position="after">
                <field name="is_certification" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
