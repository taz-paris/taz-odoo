<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="employee_skill_level_view_form_inherit_hr_skill_grade" model="ir.ui.view">
        <field name="name">hr.skill.level.form.inherit.hr_skill_grade</field>
        <field name="model">hr.skill.level</field>
        <field name="inherit_id" ref="hr_skills.employee_skill_level_view_form"/>
        <field name="arch" type="xml">
            <field name="level_progress" position="after">
                <field name="description"/>
            </field>
        </field>
    </record>

    <record id="employee_skill_level_view_tree_inherit_hr_skill_grade" model="ir.ui.view">
        <field name="name">hr.skill.level.list.inherit.hr_skill_grade</field>
        <field name="model">hr.skill.level</field>
        <field name="inherit_id" ref="hr_skills.employee_skill_level_view_tree"/>
        <field name="arch" type="xml">
            <field name="default_level" position="after">
                <field name="description" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
