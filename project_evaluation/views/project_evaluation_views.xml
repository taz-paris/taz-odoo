<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="project_evaluation_view_list" model="ir.ui.view">
        <field name="name">project.evaluation.list</field>
        <field name="model">project.evaluation</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="template_id" optional="show"/>
                <field name="is_published" optional="hide"/>
                <field name="employee_validated" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="project_evaluation_view_form" model="ir.ui.view">
        <field name="name">project.evaluation.form</field>
        <field name="model">project.evaluation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="ongoing,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="project_id"/>
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                        </group>
                        <group>
                            <field name="template_id"/>
                            <field name="is_published"/>
                            <field name="employee_validated"/>
                            <field name="employee_validated_on" readonly="1" invisible="not employee_validated"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Évaluateurs">
                            <field name="assessor_ids">
                                <list editable="bottom">
                                    <field name="employee_id" widget="many2one_avatar_employee"/>
                                    <field name="state"/>
                                    <field name="validated_on" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contenu (JSON)">
                            <field name="data" nolabel="1" widget="text" readonly="state == 'closed'"/>
                        </page>
                        <page string="Aperçu">
                            <field name="template_form" invisible="1"/>
                            <field name="template_form_template" invisible="1"/>
                            <field name="data" widget="project_evaluation_preview" nolabel="1" readonly="state == 'closed'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_evaluation_view_search" model="ir.ui.view">
        <field name="name">project.evaluation.search</field>
        <field name="model">project.evaluation</field>
        <field name="arch" type="xml">
            <search string="Évaluations de mission">
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="template_id"/>
                <filter name="state_ongoing" string="En cours" domain="[('state', '=', 'ongoing')]"/>
                <filter name="state_closed" string="Fermée" domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Projet" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Consultant" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="project_evaluation_action" model="ir.actions.act_window">
        <field name="name">Évaluations de mission</field>
        <field name="res_model">project.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

</odoo>
