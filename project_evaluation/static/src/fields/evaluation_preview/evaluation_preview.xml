<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="project_evaluation.EvaluationPreview">
        <div class="o_project_evaluation_preview">
            <t t-if="renderMode === 'rich'">
                <t t-foreach="richNodes" t-as="node" t-key="node_index">
                    <t t-call="project_evaluation.EvaluationPreview.RichNode">
                        <t t-set="node" t-value="node"/>
                    </t>
                </t>
            </t>
            <t t-elif="renderMode === 'legacy'">
                <div class="alert alert-info o_pe_legacy_notice" role="alert">
                    Gabarit sans formulaire éditeur exploitable : aperçu en lecture seule uniquement.
                </div>
                <t t-foreach="legacyNodes" t-as="node" t-key="node_index">
                    <t t-call="project_evaluation.EvaluationPreview.LegacyNode">
                        <t t-set="node" t-value="node"/>
                    </t>
                </t>
            </t>
            <t t-else="">
                <div class="text-muted">
                    Aucun gabarit exploitable pour cette évaluation : voir l'onglet "Contenu (JSON)".
                </div>
            </t>
        </div>
    </t>

    <!-- ==================== Dialecte riche (form_template) : éditable ==================== -->

    <t t-name="project_evaluation.EvaluationPreview.RichNode">

        <t t-if="node.type === 'text'">
            <div class="o_pe_markdown" t-att-style="node.styles and node.styles.text">
                <t t-foreach="parseMarkdown(node.text)" t-as="paragraph" t-key="paragraph_index">
                    <div class="o_pe_md_line">
                        <t t-if="!paragraph.length">&#160;</t>
                        <t t-foreach="paragraph" t-as="segment" t-key="segment_index">
                            <span t-attf-class="{{segment.bold ? 'fw-bold' : ''}} {{segment.italic ? 'fst-italic' : ''}}" t-esc="segment.text"/>
                        </t>
                    </div>
                </t>
            </div>
        </t>

        <t t-elif="node.type === 'divider'">
            <hr class="o_pe_divider"/>
        </t>

        <t t-elif="node.type === 'skills'">
            <div class="alert alert-secondary o_pe_skills_placeholder" role="alert">
                Module d'évaluation des compétences (affichage détaillé non encore implémenté côté Odoo).
            </div>
        </t>

        <t t-elif="node.type === 'textarea' or node.type === 'input'">
            <div class="o_pe_field">
                <div t-if="node.title" class="o_pe_field_title" t-att-style="node.styles and node.styles.title" t-esc="node.title"/>
                <div t-if="node.description" class="o_pe_field_desc text-muted" t-att-style="node.styles and node.styles.description" t-esc="node.description"/>
                <textarea t-if="!isReadonly and node.type === 'textarea'"
                          class="form-control o_pe_field_input"
                          t-att-rows="node.countRows || 3"
                          t-att-placeholder="node.placeholder"
                          t-att-value="getValue(node.key)"
                          t-on-change="(ev) => this.onFieldInput(node, ev)"/>
                <input t-elif="!isReadonly" type="text"
                       class="form-control o_pe_field_input"
                       t-att-placeholder="node.placeholder"
                       t-att-value="getValue(node.key)"
                       t-on-change="(ev) => this.onFieldInput(node, ev)"/>
                <div t-else="" class="o_pe_field_value" t-esc="getValue(node.key) || '—'"/>
            </div>
        </t>

        <t t-elif="node.type === 'select'">
            <div class="o_pe_field">
                <div t-if="node.title" class="o_pe_field_title" t-esc="node.title"/>
                <select t-if="!isReadonly" class="form-select o_pe_field_input"
                        t-on-change="(ev) => this.onFieldSelectChange(node, ev)">
                    <option value="">—</option>
                    <t t-foreach="selectOptions(node)" t-as="opt" t-key="opt.id">
                        <option t-att-value="opt.id" t-att-selected="getValue(node.key) === opt.id" t-esc="opt.text"/>
                    </t>
                </select>
                <div t-else="" class="o_pe_field_value" t-esc="selectLabel(node, getValue(node.key)) || '—'"/>
            </div>
        </t>

        <t t-elif="node.type === 'table'">
            <div class="o_pe_table_block">
                <div t-if="node.title" class="o_pe_table_title" t-esc="node.title"/>
                <table class="table table-sm table-bordered o_pe_table">
                    <thead t-if="node.hasHeader">
                        <tr>
                            <t t-foreach="node.columns || []" t-as="col" t-key="col.key">
                                <th t-esc="tableColumnTitle(col)"/>
                            </t>
                            <th t-if="node.hasRowAdd and !isReadonly" class="o_pe_table_action_col"/>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="Array.from({length: tableRowCount(node)})" t-as="row" t-key="row_index">
                            <tr>
                                <t t-foreach="node.columns || []" t-as="col" t-key="col.key">
                                    <td class="o_pe_table_cell">
                                        <t t-if="col.type === 'text'">
                                            <t t-esc="tableStaticCellText(node, col.key, row_index)"/>
                                        </t>
                                        <t t-elif="col.type === 'select'">
                                            <select t-if="!isReadonly" class="form-select form-select-sm"
                                                    t-on-change="(ev) => this.onCellSelectChange(node, row_index, col, ev)">
                                                <option value="">—</option>
                                                <t t-foreach="selectOptions(col)" t-as="opt" t-key="opt.id">
                                                    <option t-att-value="opt.id" t-att-selected="getCell(node.key, row_index, col.key) === opt.id" t-esc="opt.text"/>
                                                </t>
                                            </select>
                                            <t t-else="" t-esc="selectLabel(col, getCell(node.key, row_index, col.key)) || '—'"/>
                                        </t>
                                        <t t-else="">
                                            <textarea t-if="!isReadonly" class="form-control form-control-sm o_pe_table_cell_input"
                                                      rows="2"
                                                      t-att-placeholder="tableCellPlaceholder(node, col.key, row_index)"
                                                      t-att-value="getCell(node.key, row_index, col.key)"
                                                      t-on-change="(ev) => this.onCellInput(node, row_index, col, ev)"/>
                                            <t t-else="" t-esc="getCell(node.key, row_index, col.key) || '—'"/>
                                        </t>
                                    </td>
                                </t>
                                <td t-if="node.hasRowAdd and !isReadonly" class="o_pe_table_action_col">
                                    <button class="btn btn-sm btn-link text-danger o_pe_remove_row" type="button"
                                            t-on-click="() => this.onRemoveRowClick(node, row_index)">
                                        <i class="fa fa-trash"/>
                                    </button>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <button t-if="node.hasRowAdd and !isReadonly" type="button" class="btn btn-sm btn-link o_pe_add_row"
                        t-on-click="() => this.onAddRowClick(node)">
                    <i class="fa fa-plus"/> Ajouter une ligne
                </button>
            </div>
        </t>

        <t t-elif="node.type === 'section'">
            <div class="o_pe_section">
                <h5 t-if="node.title" t-att-style="node.styles and node.styles.title" t-esc="node.title"/>
                <t t-foreach="node.children || []" t-as="child" t-key="child_index">
                    <t t-call="project_evaluation.EvaluationPreview.RichNode">
                        <t t-set="node" t-value="child"/>
                    </t>
                </t>
            </div>
        </t>

        <t t-elif="node.type === 'columns'">
            <div class="o_pe_group">
                <t t-foreach="node.children || []" t-as="child" t-key="child_index">
                    <div class="o_pe_group_item">
                        <t t-call="project_evaluation.EvaluationPreview.RichNode">
                            <t t-set="node" t-value="child"/>
                        </t>
                    </div>
                </t>
            </div>
        </t>

        <t t-else="">
            <div class="text-muted o_pe_unsupported">
                Composant non géré : <t t-esc="node.type"/>
            </div>
        </t>
    </t>

    <!-- ==================== Dialecte simplifié (form) : lecture seule uniquement ==================== -->

    <t t-name="project_evaluation.EvaluationPreview.LegacyNode">
        <t t-if="node.component === 'MarkdownDisplay'">
            <div class="o_pe_markdown">
                <t t-foreach="parseMarkdown(legacyMarkdownText(node))" t-as="paragraph" t-key="paragraph_index">
                    <div class="o_pe_md_line">
                        <t t-if="!paragraph.length">&#160;</t>
                        <t t-foreach="paragraph" t-as="segment" t-key="segment_index">
                            <span t-attf-class="{{segment.bold ? 'fw-bold' : ''}} {{segment.italic ? 'fst-italic' : ''}}" t-esc="segment.text"/>
                        </t>
                    </div>
                </t>
            </div>
        </t>

        <t t-elif="node.component === 'TextArea'">
            <div class="o_pe_field">
                <div class="o_pe_field_title" t-esc="node.title"/>
                <div t-if="node.description" class="o_pe_field_desc text-muted" t-esc="node.description"/>
                <div class="o_pe_field_value" t-esc="legacyFieldValue(node)"/>
            </div>
        </t>

        <t t-elif="node.component === 'Selector'">
            <div class="o_pe_field">
                <div class="o_pe_field_title" t-esc="node.title"/>
                <div class="o_pe_field_value" t-esc="legacySelectorLabel(node) || '—'"/>
            </div>
        </t>

        <t t-elif="node.component === 'Table'">
            <div class="o_pe_table_block">
                <div t-if="node.title" class="o_pe_table_title" t-esc="node.title"/>
                <table class="table table-sm table-bordered o_pe_table">
                    <thead>
                        <tr>
                            <t t-foreach="legacyTableColumns(node)" t-as="col" t-key="col_index">
                                <th t-esc="col.title"/>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="legacyTableRows(node)" t-as="row" t-key="row_index">
                            <tr>
                                <t t-foreach="row" t-as="cell" t-key="cell_index">
                                    <td class="o_pe_table_cell" t-esc="cell"/>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>

        <t t-elif="node.component === 'Section'">
            <div class="o_pe_section">
                <h5 t-if="node.title" t-esc="node.title"/>
                <t t-foreach="node.items || []" t-as="child" t-key="child_index">
                    <t t-call="project_evaluation.EvaluationPreview.LegacyNode">
                        <t t-set="node" t-value="child"/>
                    </t>
                </t>
            </div>
        </t>

        <t t-elif="node.component === 'Group'">
            <div class="o_pe_group">
                <t t-foreach="node.items || []" t-as="child" t-key="child_index">
                    <div class="o_pe_group_item">
                        <t t-call="project_evaluation.EvaluationPreview.LegacyNode">
                            <t t-set="node" t-value="child"/>
                        </t>
                    </div>
                </t>
            </div>
        </t>

        <t t-else="">
            <div class="text-muted o_pe_unsupported">
                Composant non géré : <t t-esc="node.component"/>
            </div>
        </t>
    </t>

</templates>
