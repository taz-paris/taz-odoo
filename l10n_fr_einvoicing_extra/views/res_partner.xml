<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
      l10n_fr_einvoicing only looks at parent_id to decide whether to show
      the full "eInvoicing for France" settings or the "managed on the
      parent company" redirect. But a partner with a parent can still be
      its own commercial entity (is_company=True with its own SIREN), in
      which case commercial_partner_id == id and the redirect button
      (open_commercial_entity) just reopens the same record in a loop.
      We use commercial_partner_id vs id to detect that case instead.
    -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_fr_einvoicing.view_partner_form" />
        <field name="arch" type="xml">
            <group name="fr_einvoicing" position="attributes">
                <attribute
                    name="invisible"
                >not is_france_country or (parent_id and commercial_partner_id != id)</attribute>
            </group>
            <group name="fr_einvoicing_child" position="attributes">
                <attribute
                    name="invisible"
                >not is_france_country or not parent_id or commercial_partner_id == id</attribute>
            </group>
        </field>
    </record>

        <record id="res_partner_l10n_fr_einvoicing_extra_view_form_inherit" model="ir.ui.view">
            <field name="name">Partner</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="taz-common.company_form"/>
            <field name="arch" type="xml">
		    <group name="misc" position="after">
			<group
			    name="fr_einvoicing"
			    string="eInvoicing for France"
			    invisible="not is_france_country or (parent_id and commercial_partner_id != id)"
			>
			    <field
				name="fr_directory_entity_type"
				widget="badge"
				decoration-warning="fr_directory_entity_type == 'private_inactive'"
				decoration-success="fr_directory_entity_type == 'private'"
				decoration-danger="fr_directory_entity_type == 'no'"
				decoration-info="fr_directory_entity_type == 'public'"
			    />
			    <field name="fr_directory_name" />
			    <field
				name="fr_directory_closed"
				invisible="not fr_directory_closed"
			    />
			    <field
				name="fr_directory_siren"
				invisible="not fr_directory_siren"
			    />
			    <field
				name="fr_directory_siret"
				invisible="fr_directory_entity_type != 'public'"
			    />
			    <field name="fr_directory_last_sync_date" />
			    <field
				name="default_fr_directory_line_id"
				invisible="not fr_directory_line_show"
			    />
			    <div colspan="2" id="directory_lines">
				<button
				    name="%(l10n_fr_einvoicing.fr_directory_line_action)d"
				    context="{'search_default_partner_id': id, 'search_default_active': True}"
				    class="oe_stat_button"
				    type="action"
				>
				    <field
					name="fr_directory_line_active_count"
					string="Active Directory Lines"
					widget="statinfo"
				    />
				</button>
			    </div>
			    <field name="fr_directory_line_show" invisible="1" />
			    <field name="fr_directory_entity_changed_warning" invisible="1" />
			    <field
				name="fr_directory_show_warning_missing_siren"
				invisible="1"
			    />
			    <button
				name="fr_directory_sync_button"
				type="object"
				string="Directory Sync"
			    />
			</group>
			<group
			    name="fr_einvoicing_child"
			    string="eInvoicing for France"
			    invisible="not is_france_country or not parent_id or commercial_partner_id == id"
			>
			    <field
				name="default_fr_directory_line_id"
				invisible="not fr_directory_line_show"
			    />
			    <p>Other parameters are managed on <button
				name="open_commercial_entity"
				type="object"
				string="the parent company"
				class="oe_link"
			    /></p>
			</group>
		    </group>


		    <!--
		    <xpath
			expr="//field[@name='child_ids']/form//field[@name='email']"
			position="before"
		    >
			<field
			    name="default_fr_directory_line_id"
			    invisible="not fr_directory_line_show"
			/>
			<field name="fr_directory_line_show" invisible="1" />
		    </xpath>
		   -->

		<field name="active" position="after">
			<div
			    name="fr_directory_closed"
			    invisible="not fr_directory_show_warning_closed"
			    class="alert alert-warning"
			    role="alert"
			>According to the directory, this entity is <strong>closed</strong>.
					    </div>
			<div
			    name="entity_changed_warning"
			    invisible="not fr_directory_entity_changed_warning"
			    class="alert alert-warning"
			    role="alert"
			>
			    <field name="fr_directory_entity_changed_warning" />
			</div>
			<div
			    name="fr_company_without_siren"
			    invisible="not fr_directory_show_warning_missing_siren"
			    class="alert alert-warning"
			    role="alert"
			>You should <strong
			>set a SIREN, SIRET or VAT number</strong> on this France-based entity.
					    </div>
		</field>
            </field>
        </record>
</odoo>

