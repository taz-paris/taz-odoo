<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">Account move</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting_info_group']" position="after">
                <group string="Références documentaires (EN16931)" name="l10n_fr_bt_references">
                    <field name="l10n_fr_bt12_contract_reference" />
                    <field name="l10n_fr_bt15_receiving_advice_reference" />
                    <field name="l10n_fr_bt16_despatch_advice_reference" />
                    <field name="l10n_fr_bt17_tender_reference" />
                    <field name="l10n_fr_bt18_invoiced_object_reference" />
                    <field name="l10n_fr_bt18_invoiced_object_scheme" />
                    <field name="l10n_fr_bt19_buyer_accounting_reference" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
