<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="staffing.StaffingRequestsPage">
        <div class="o_napta_staffing_requests" t-on-click="closeMenus">

            <!-- Header -->
            <div class="osr_header">
                <div class="osr_title_block">
                    <h1>Demandes</h1>
                    <div class="osr_counter">
                        <span t-esc="totalCount + ' demandes'"/>
                        <span class="osr_counter_sep">·</span>
                        <span t-esc="noOwnerCount + ' sans suggestion ni pré-réservation'"/>
                    </div>
                </div>
                <div class="osr_header_spacer"/>

                <i class="fa fa-smile-o osr_mood_icon" title="Donner votre avis sur cette page"/>

                <div class="osr_dropdown_wrap">
                    <button type="button" class="osr_icon_btn" t-on-click="(ev) => this.toggleDropdown('showExportMenu', ev)">
                        <i class="fa fa-download"/>
                    </button>
                    <button type="button" class="osr_icon_caret_btn" t-on-click="(ev) => this.toggleDropdown('showExportMenu', ev)">
                        <i class="fa fa-chevron-down"/>
                    </button>
                    <div t-if="state.showExportMenu" class="osr_dropdown osr_export_dropdown" t-on-click.stop="">
                        <div class="osr_dropdown_item">
                            <i class="fa fa-table"/>
                            <span>Exporter les périodes des demandes</span>
                        </div>
                        <div class="osr_dropdown_item">
                            <i class="fa fa-list-alt"/>
                            <span>Exporter les demandes</span>
                        </div>
                    </div>
                </div>

                <button type="button" class="osr_btn_scenario" t-att-data-tooltip="scenarioTooltip">
                    <i class="fa fa-magic"/> Résoudre avec Scenario Architect
                    <span class="osr_badge_beta">bêta</span>
                </button>

                <div class="osr_dropdown_wrap">
                    <button type="button" class="osr_btn_primary" t-on-click="(ev) => this.toggleDropdown('showCreateMenu', ev)">
                        Créer une demande <i class="fa fa-chevron-down"/>
                    </button>
                    <div t-if="state.showCreateMenu" class="osr_dropdown osr_create_dropdown" t-on-click.stop="">
                        <div class="osr_dropdown_item" t-on-click="(ev) => this.openCreateDrawer('single', ev)">
                            <i class="fa fa-plus"/>
                            <span>Créer une demande</span>
                        </div>
                        <div class="osr_dropdown_item" t-on-click="(ev) => this.openCreateDrawer('multiple', ev)">
                            <i class="fa fa-files-o"/>
                            <span>Créer plusieurs demandes</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Toolbar -->
            <div class="osr_toolbar">
                <div class="osr_toolbar_left">
                    <div class="osr_dropdown_wrap">
                        <button type="button" class="osr_toolbar_btn" t-on-click="(ev) => this.toggleDropdown('showViews', ev)">
                            <i class="fa fa-bookmark-o"/> Vues
                        </button>
                        <div t-if="state.showViews" class="osr_dropdown osr_views_dropdown" t-on-click.stop="">
                            <div class="osr_views_title">Sauvegarder la vue actuelle</div>
                            <div class="osr_views_empty">Aucune vue enregistrée</div>
                        </div>
                    </div>

                    <div class="osr_dropdown_wrap">
                        <button type="button" class="osr_toolbar_btn" t-on-click="(ev) => this.toggleDropdown('showFilter', ev)">
                            <i class="fa fa-filter"/> Filtrer
                        </button>
                        <div t-if="state.showFilter" class="osr_dropdown osr_filter_dropdown" t-on-click.stop="">
                            <input type="text" class="osr_filter_search" placeholder="Rechercher un filtre"/>
                            <t t-foreach="filterSections" t-as="section" t-key="section.title">
                                <div class="osr_filter_section_title" t-esc="section.title"/>
                                <div t-foreach="section.items" t-as="item" t-key="item" class="osr_filter_item">
                                    <span t-esc="item"/>
                                    <i class="fa fa-chevron-right osr_filter_chevron"/>
                                </div>
                            </t>
                            <button type="button" class="osr_filter_save">Enregistrer</button>
                        </div>
                    </div>
                </div>

                <div class="osr_toolbar_right">
                    <div class="osr_dropdown_wrap">
                        <button type="button" class="osr_toolbar_btn" t-on-click="(ev) => this.toggleDropdown('showColumns', ev)">
                            Colonnes <i class="fa fa-chevron-down"/>
                        </button>
                        <div t-if="state.showColumns" class="osr_dropdown osr_columns_dropdown" t-on-click.stop="">
                            <div class="osr_columns_title">Tout sélectionner</div>
                            <div t-foreach="columnsMenu" t-as="label" t-key="label" class="osr_columns_item">
                                <i class="fa fa-check"/>
                                <span t-esc="label"/>
                                <i class="fa fa-ellipsis-v osr_columns_handle"/>
                            </div>
                        </div>
                    </div>

                    <div class="osr_tabs">
                        <t t-foreach="tabs" t-as="tab" t-key="tab.key">
                            <div t-att-class="{ osr_tab: true, osr_tab_active: state.activeTab === tab.key }"
                                 t-on-click="() => this.setTab(tab.key)">
                                <span t-esc="tab.label"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Bulk bar -->
            <div t-if="selectedCount" class="osr_bulk_bar">
                <span class="osr_bulk_count" t-esc="selectedCount + ' demandes sélectionnées'"/>
                <button type="button" class="osr_bulk_btn"><i class="fa fa-trash-o"/> Supprimer</button>
                <button type="button" class="osr_bulk_btn"><i class="fa fa-clone"/> Dupliquer</button>
                <button type="button" class="osr_bulk_btn"><i class="fa fa-sign-in"/> Attacher à un autre projet</button>
                <button type="button" class="osr_bulk_btn"><i class="fa fa-arrows-h"/> Décaler</button>
                <button type="button" class="osr_bulk_btn"><i class="fa fa-calendar-plus-o"/> Ajouter des périodes</button>
            </div>

            <!-- Tableau -->
            <div class="osr_table_wrap">
                <table class="osr_table">
                    <thead>
                        <tr>
                            <th class="osr_th_checkbox"><i class="fa fa-square-o"/></th>
                            <t t-foreach="tableColumns" t-as="col" t-key="col.key">
                                <th t-on-click="() => this.sortBy(col)" t-att-class="{ osr_th_sortable: col.sortable }">
                                    <span t-esc="col.label"/>
                                    <i t-if="col.sortable" t-attf-class="fa {{ sortIcon(col) }} osr_sort_icon"/>
                                </th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="sortedRequests" t-as="row" t-key="row.id">
                            <td class="osr_th_checkbox" t-on-click="(ev) => this.toggleSelect(row, ev)">
                                <i t-att-class="isSelected(row) ? 'fa fa-check-square' : 'fa fa-square-o'"/>
                            </td>
                            <td class="osr_td_project" t-esc="row.project"/>
                            <td t-esc="row.client"/>
                            <td t-esc="row.startDate"/>
                            <td t-esc="row.endDate"/>
                            <td t-esc="row.soldDays + ' j'"/>
                            <td t-esc="row.workloadDays + ' j'"/>
                            <td t-esc="row.workloadPct + '%'"/>
                            <td>
                                <span t-if="row.preBooked.length" class="osr_badge_user">
                                    <span class="osr_badge_user_count" t-esc="row.preBooked.length"/>
                                    <span class="osr_badge_user_names" t-esc="row.preBooked.join(', ')"/>
                                </span>
                            </td>
                            <td>
                                <span t-if="row.status" class="osr_status_pending" t-esc="row.status"/>
                            </td>
                            <td class="osr_td_bu">
                                <span t-foreach="row.businessUnits" t-as="bu" t-key="bu" class="osr_bu_tag" t-esc="bu"/>
                            </td>
                        </tr>
                        <tr t-if="!sortedRequests.length">
                            <td t-att-colspan="tableColumns.length + 1" class="osr_empty">Aucune demande dans cet onglet.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Tiroir "Créer une demande" -->
            <div t-if="state.createDrawer === 'single'" class="osr_create_overlay" t-on-click="closeCreateDrawer">
                <div class="osr_create_drawer" t-on-click="(ev) => { ev.stopPropagation(); this.closeCreateDropdowns(); }">
                    <div class="osr_create_header">
                        <h3>Créer une demande</h3>
                        <i class="fa fa-times" t-on-click="closeCreateDrawer"/>
                    </div>

                    <label class="osr_create_label"><i class="fa fa-magic"/> Décrivez votre besoin</label>
                    <textarea class="osr_create_textarea" rows="4"
                              placeholder="Collez une fiche de poste, écrivez librement...  Exemple : Besoin d'un développeur Java senior avec Spring Boot"
                              t-model="state.createNeed"/>
                    <button type="button" class="btn osr_create_ai_btn" t-att-disabled="!state.createNeed">
                        <i class="fa fa-magic"/> Analyser les critères avec l'IA
                    </button>

                    <div class="osr_create_divider">ou remplissez le formulaire manuellement</div>

                    <label class="osr_create_label">Projet <span class="osr_create_required">*</span></label>
                    <select class="osr_create_select" t-model="state.createProject">
                        <option value="">Sélectionner un projet…</option>
                        <option t-foreach="projectOptions" t-as="p" t-key="p" t-att-value="p" t-esc="p"/>
                    </select>

                    <!-- Critères -->
                    <div class="osr_create_section" t-on-click="(ev) => this.toggleCreateSection('criteria', ev)">
                        <i class="fa fa-bullseye"/>
                        <span>Critères</span>
                        <span class="osr_create_section_count" t-esc="criteriaCount"/>
                        <i t-attf-class="fa {{ isCreateSectionOpen('criteria') ? 'fa-chevron-up' : 'fa-chevron-down' }} osr_create_section_chevron"/>
                    </div>
                    <div t-if="isCreateSectionOpen('criteria')" class="osr_create_section_body">
                        <t t-foreach="criteriaFields" t-as="field" t-key="field.key">
                            <label class="osr_create_label" t-esc="field.label"/>
                            <div class="osr_create_dropdown_wrap">
                                <button type="button" class="osr_create_dropdown_btn" t-on-click="(ev) => this.toggleCriteriaDropdown(field.key, ev)">
                                    <span t-esc="criteriaFieldSummary(field.key)"/>
                                    <i t-attf-class="fa {{ isCriteriaDropdownOpen(field.key) ? 'fa-chevron-up' : 'fa-chevron-down' }}"/>
                                </button>
                                <div t-if="isCriteriaDropdownOpen(field.key)" class="osr_create_dropdown_menu">
                                    <div t-foreach="field.options" t-as="opt" t-key="opt" class="osr_create_dropdown_item"
                                         t-on-click="(ev) => this.toggleCriteriaValue(field.key, opt, ev)">
                                        <i t-attf-class="fa {{ isCriteriaValueSelected(field.key, opt) ? 'fa-check-square' : 'fa-square-o' }}"/>
                                        <span t-esc="opt"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Périodes -->
                    <div class="osr_create_section" t-on-click="(ev) => this.toggleCreateSection('periods', ev)">
                        <i class="fa fa-clock-o"/>
                        <span>Périodes</span>
                        <span class="osr_create_section_count" t-esc="state.createPeriods.length"/>
                        <i t-attf-class="fa {{ isCreateSectionOpen('periods') ? 'fa-chevron-up' : 'fa-chevron-down' }} osr_create_section_chevron"/>
                    </div>
                    <div t-if="isCreateSectionOpen('periods')" class="osr_create_section_body">
                        <div t-foreach="state.createPeriods" t-as="period" t-key="period.id" class="osr_create_period_row">
                            <input type="date" class="osr_create_period_date" t-model="period.start"/>
                            <span class="osr_create_period_sep">–</span>
                            <input type="date" class="osr_create_period_date" t-model="period.end"/>
                            <input type="number" min="0" class="osr_create_period_amount" t-model="period.amount"/>
                            <select class="osr_create_period_unit" t-model="period.unit">
                                <option t-foreach="periodUnits" t-as="u" t-key="u" t-att-value="u" t-esc="u"/>
                            </select>
                            <i class="fa fa-trash-o osr_create_period_remove" t-on-click="(ev) => this.removeCreatePeriod(period, ev)"/>
                        </div>
                        <div t-if="!state.createPeriods.length" class="osr_create_empty_hint">Aucune période ajoutée.</div>
                        <button type="button" class="osr_create_add_period" t-on-click="addCreatePeriod">
                            <i class="fa fa-plus"/> Ajouter une période d'affectation
                        </button>
                    </div>

                    <!-- Utilisateurs -->
                    <div class="osr_create_section" t-on-click="(ev) => this.toggleCreateSection('users', ev)">
                        <i class="fa fa-user-o"/>
                        <span>Utilisateurs <span class="osr_create_required">*</span></span>
                        <span class="osr_create_section_count" t-esc="state.createUsers.length"/>
                        <i t-attf-class="fa {{ isCreateSectionOpen('users') ? 'fa-chevron-up' : 'fa-chevron-down' }} osr_create_section_chevron"/>
                    </div>
                    <div t-if="isCreateSectionOpen('users')" class="osr_create_section_body">
                        <div t-if="state.createUsers.length" class="osr_create_user_chips">
                            <span t-foreach="state.createUsers" t-as="name" t-key="name" class="osr_create_user_chip">
                                <span t-esc="name"/>
                                <i class="fa fa-times" t-on-click="(ev) => this.removeCreateUser(name, ev)"/>
                            </span>
                        </div>
                        <div class="osr_create_dropdown_wrap">
                            <input type="text" class="osr_create_user_search" placeholder="Rechercher un utilisateur…"
                                   t-model="state.createUserSearch" t-on-click="focusCreateUserSearch"/>
                            <div t-if="state.createUserSearchFocused" class="osr_create_dropdown_menu">
                                <div t-foreach="createUserSuggestions" t-as="name" t-key="name" class="osr_create_dropdown_item"
                                     t-on-click="(ev) => this.addCreateUser(name, ev)">
                                    <span t-esc="name"/>
                                </div>
                                <div t-if="!createUserSuggestions.length" class="osr_create_empty_hint">Aucun utilisateur trouvé.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Informations -->
                    <div class="osr_create_section" t-on-click="(ev) => this.toggleCreateSection('information', ev)">
                        <i class="fa fa-info-circle"/>
                        <span>Informations</span>
                        <span class="osr_create_section_count" t-esc="informationCount"/>
                        <i t-attf-class="fa {{ isCreateSectionOpen('information') ? 'fa-chevron-up' : 'fa-chevron-down' }} osr_create_section_chevron"/>
                    </div>
                    <div t-if="isCreateSectionOpen('information')" class="osr_create_section_body">
                        <label class="osr_create_label">Statut de l'affectation</label>
                        <select class="osr_create_select" t-model="state.createInfo.status">
                            <option value="">Sélectionner…</option>
                            <option t-foreach="assignmentStatusOptions" t-as="s" t-key="s" t-att-value="s" t-esc="s"/>
                        </select>
                        <label class="osr_create_label">Jours vendus</label>
                        <input type="number" min="0" class="osr_create_input" t-model="state.createInfo.daysSold"/>
                        <label class="osr_create_label">Description de la mission</label>
                        <input type="text" class="osr_create_input" t-model="state.createInfo.description"/>
                        <label class="osr_create_label">Durée</label>
                        <input type="text" class="osr_create_input" t-model="state.createInfo.duration"/>
                        <label class="osr_create_label">Priorité</label>
                        <select class="osr_create_select" t-model="state.createInfo.priority">
                            <option value="">Sélectionner…</option>
                            <option t-foreach="priorityOptions" t-as="p" t-key="p" t-att-value="p" t-esc="p"/>
                        </select>
                    </div>

                    <!-- Commentaires -->
                    <div class="osr_create_section" t-on-click="(ev) => this.toggleCreateSection('comments', ev)">
                        <i class="fa fa-comment-o"/>
                        <span>Commentaires</span>
                        <span class="osr_create_section_count" t-esc="commentCount"/>
                        <i t-attf-class="fa {{ isCreateSectionOpen('comments') ? 'fa-chevron-up' : 'fa-chevron-down' }} osr_create_section_chevron"/>
                    </div>
                    <div t-if="isCreateSectionOpen('comments')" class="osr_create_section_body">
                        <textarea class="osr_create_textarea" rows="3" maxlength="200"
                                  placeholder="Ajouter un commentaire, taguez un collègue avec @"
                                  t-model="state.createComment"/>
                        <div class="osr_create_char_count" t-esc="state.createComment.length + ' / ' + commentMaxLength + ' caractères'"/>
                    </div>

                    <div class="osr_create_footer">
                        <button type="button" class="btn osr_create_preview_btn"><i class="fa fa-search"/> Aperçu</button>
                        <button type="button" class="btn osr_create_cancel_btn" t-on-click="closeCreateDrawer">Fermer</button>
                        <button type="button" class="btn osr_create_save_btn" t-att-disabled="!state.createProject" t-on-click="closeCreateDrawer">Enregistrer</button>
                    </div>
                </div>
            </div>

            <!-- Tiroir "Créer plusieurs demandes" -->
            <div t-if="state.createDrawer === 'multiple'" class="osr_create_overlay" t-on-click="closeCreateDrawer">
                <div class="osr_create_drawer" t-on-click.stop="">
                    <div class="osr_create_header">
                        <h3>Créer plusieurs demandes</h3>
                        <i class="fa fa-times" t-on-click="closeCreateDrawer"/>
                    </div>

                    <label class="osr_create_label"><i class="fa fa-magic"/> Décrivez votre besoin</label>
                    <div class="osr_create_textarea_wrap">
                        <textarea class="osr_create_textarea" rows="6"
                                  placeholder="Collez une fiche de poste, écrivez librement...  Exemple : Besoin d'un développeur Java senior"
                                  t-model="state.createNeed"/>
                        <button type="button" class="osr_create_pdf_btn"><i class="fa fa-paperclip"/> Ajouter un fichier PDF</button>
                    </div>

                    <label class="osr_create_label">Projet <span class="osr_create_required">*</span></label>
                    <select class="osr_create_select" t-model="state.createProject">
                        <option value="">Sélectionner un projet…</option>
                        <option t-foreach="projectOptions" t-as="p" t-key="p" t-att-value="p" t-esc="p"/>
                    </select>

                    <div class="osr_create_footer">
                        <button type="button" class="btn osr_create_cancel_btn" t-on-click="closeCreateDrawer">Fermer</button>
                        <button type="button" class="btn osr_create_save_btn osr_create_ai_save" t-att-disabled="!state.createProject" t-on-click="closeCreateDrawer">
                            <i class="fa fa-magic"/> Analyser avec l'IA
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </t>

</templates>
