<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="staffing.CareerTracksPage">
        <div class="o_napta_career_tracks">
            <div class="o_napta_ct_header">
                <h1>Parcours de carrière</h1>
                <button class="btn o_napta_ct_new_btn" disabled="disabled">
                    <i class="fa fa-plus"/> Nouveau parcours
                </button>
            </div>

            <div class="o_napta_tabs">
                <t t-foreach="tabs" t-as="tab" t-key="tab">
                    <div t-att-class="{ o_napta_tab: true, o_napta_tab_active: tab === state.activeTab }"
                         t-on-click="() => this.setTab(tab)">
                        <span t-esc="tab"/>
                    </div>
                </t>
            </div>

            <div class="o_napta_ct_board">
                <t t-foreach="tracks" t-as="track" t-key="track.id">
                    <div class="o_napta_ct_card">
                        <div class="o_napta_ct_card_head">
                            <div class="o_napta_ct_card_title" t-esc="track.title"/>
                            <div class="o_napta_ct_card_menu_wrap">
                                <button class="o_napta_ct_card_menu_btn" t-on-click="() => this.toggleMenu(track.id)">
                                    <i class="fa fa-ellipsis-v"/>
                                </button>
                                <div t-if="isMenuOpen(track.id)" class="o_napta_ct_card_menu">
                                    <div class="o_napta_ct_card_menu_item">
                                        <i class="fa fa-eye"/> Voir le détail
                                    </div>
                                    <div class="o_napta_ct_card_menu_item">
                                        <i class="fa fa-pencil"/> Éditer le parcours
                                    </div>
                                    <div class="o_napta_ct_card_menu_item o_napta_ct_card_menu_item_danger">
                                        <i class="fa fa-trash-o"/> Supprimer le parcours de carrière
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="o_napta_ct_card_sub">Fiches métier</div>
                        <ul class="o_napta_ct_card_list">
                            <t t-foreach="track.jobSheets" t-as="js" t-key="js_index">
                                <li t-esc="js"/>
                            </t>
                        </ul>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
