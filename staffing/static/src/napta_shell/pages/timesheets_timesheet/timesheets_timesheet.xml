<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="staffing.TimesheetsTimesheetPage">
        <div class="o_napta_timesheets_timesheet">

            <div class="o_napta_ts_header">
                <h1>Feuilles de temps</h1>
                <div class="o_napta_ts_viewtabs">
                    <div t-att-class="{ o_napta_ts_viewtab: true, o_napta_ts_viewtab_active: state.tab === 'personal' }"
                         t-on-click="() => this.setTab('personal')">
                        <i class="fa fa-user"/> Personnel
                    </div>
                    <div t-att-class="{ o_napta_ts_viewtab: true, o_napta_ts_viewtab_active: state.tab === 'team' }"
                         t-on-click="() => this.setTab('team')">
                        <i class="fa fa-users"/> Équipe
                    </div>
                </div>
            </div>

            <!-- ============================= VUE PERSONNELLE ============================= -->
            <t t-if="state.tab === 'personal'">

                <div class="o_napta_ts_period_row">
                    <span class="o_napta_ts_period" t-if="state.personalPeriodMode === 'week'">Février 2024 du 01/02/24 au 29/02/24</span>
                    <span class="o_napta_ts_period" t-else="">Semaine du 04/03/24 au 10/03/24</span>
                    <span class="o_napta_badge_period">Partiellement validée</span>
                    <div class="o_napta_ts_periodmode">
                        <span t-att-class="{ o_napta_ts_periodmode_item: true, o_napta_ts_periodmode_active: state.personalPeriodMode === 'week' }"
                              t-on-click="() => this.setPersonalPeriodMode('week')">Semaine</span>
                        <span t-att-class="{ o_napta_ts_periodmode_item: true, o_napta_ts_periodmode_active: state.personalPeriodMode === 'day' }"
                              t-on-click="() => this.setPersonalPeriodMode('day')">Jour</span>
                    </div>
                </div>

                <div class="o_napta_ts_toolbar">
                    <button class="btn btn-sm o_napta_toolbar_btn" disabled="disabled">
                        Projet <i class="fa fa-chevron-down"/>
                    </button>
                    <div class="o_napta_ts_toolbar_spacer"/>
                    <button class="btn btn-sm o_napta_toolbar_btn" disabled="disabled">
                        <i class="fa fa-plus"/> Ajouter un projet
                    </button>
                    <button class="btn btn-sm o_napta_toolbar_btn" disabled="disabled">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <button class="btn btn-sm o_napta_toolbar_btn" disabled="disabled">
                        <t t-esc="state.personalPeriodMode === 'week' ? 'Ce mois' : 'Cette semaine'"/>
                    </button>
                    <button class="btn btn-sm o_napta_toolbar_btn" disabled="disabled">
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>

                <table t-if="state.personalPeriodMode === 'week'" class="o_napta_ts_table">
                    <thead>
                        <tr>
                            <th class="o_napta_ts_colhead"/>
                            <t t-foreach="personalWeeks" t-as="week" t-key="week.key">
                                <th class="o_napta_ts_weekhead">
                                    <span t-esc="'FROM ' + week.range.replace('DU ', '').replace(' AU ', ' TO ')"/>
                                    <i t-if="week.info" class="fa fa-info-circle o_napta_ts_info" t-att-title="week.info"/>
                                </th>
                            </t>
                            <th class="o_napta_ts_totalhead">TOTAL<br/>FÉVRIER 2024</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.personalRows" t-as="row" t-key="row.key">
                            <td class="o_napta_ts_projectcell">
                                <span t-esc="row.project"/>
                                <i t-if="isRowEmpty(row)" class="fa fa-trash-o o_napta_ts_remove"
                                   title="Retirer le projet des feuilles de temps" t-on-click="(ev) => this.removeProjectRow(row, ev)"/>
                            </td>
                            <t t-foreach="row.cells" t-as="cell" t-key="cell_index">
                                <td t-att-class="cellClass(cell)">
                                    <input type="text" class="o_napta_ts_cell_input"
                                           t-att-value="cell.value"
                                           t-att-disabled="isCellLocked(cell) ? 'disabled' : undefined"
                                           t-on-input="(ev) => this.onCellInput(cell, ev)"/>
                                    <span class="o_napta_ts_cell_unit">d</span>
                                    <i t-if="cell.movement === 'down'" class="fa fa-arrow-down o_napta_ts_movement" t-att-title="movementTooltip"/>
                                    <i t-if="cell.movement === 'up'" class="fa fa-arrow-up o_napta_ts_movement" t-att-title="movementTooltip"/>
                                </td>
                            </t>
                            <td class="o_napta_ts_totalcell">
                                <span t-esc="rowTotal(row)"/>
                            </td>
                        </tr>
                        <tr class="o_napta_ts_availability_row">
                            <td>
                                Disponibilité
                                <i t-att-data-tooltip="availabilityTooltip" class="fa fa-info-circle o_napta_ts_info"/>
                            </td>
                            <t t-foreach="personalAvailability" t-as="a" t-key="a_index">
                                <td class="o_napta_ts_availabilitycell" t-esc="a"/>
                            </t>
                            <td class="o_napta_ts_totalcell" t-esc="personalAvailabilityTotal"/>
                        </tr>
                        <tr class="o_napta_ts_actions_row">
                            <td/>
                            <t t-foreach="personalWeeks" t-as="week" t-key="week.key">
                                <td class="o_napta_ts_actioncell">
                                    <span t-if="weekStatus(week_index) === 'approved'" class="o_napta_ts_weekstatus">
                                        <i class="fa fa-lock"/> Validée
                                    </span>
                                    <span t-if="weekStatus(week_index) === 'pending'" class="o_napta_ts_weekstatus">
                                        <i class="fa fa-hourglass-half"/> En attente
                                    </span>
                                    <span t-if="weekStatus(week_index) === 'saved'" class="o_napta_ts_weekbtns">
                                        <button class="btn btn-sm o_napta_btn_submit" t-on-click="() => this.submitWeek(week_index)">Soumettre</button>
                                    </span>
                                    <span t-if="weekStatus(week_index) === 'to_complete'" class="o_napta_ts_weekbtns">
                                        <button class="btn btn-sm o_napta_btn_save" t-on-click="() => this.saveWeek(week_index)">Enregistrer</button>
                                    </span>
                                </td>
                            </t>
                            <td/>
                        </tr>
                    </tbody>
                </table>

                <!-- ===== Mode Jour : colonnes Lun→Dim, commentaire par jour ===== -->
                <table t-if="state.personalPeriodMode === 'day'" class="o_napta_ts_table" t-on-click="closeComment">
                    <thead>
                        <tr>
                            <th class="o_napta_ts_colhead"/>
                            <t t-foreach="personalDays" t-as="day" t-key="day.key">
                                <th class="o_napta_ts_weekhead">
                                    <span t-esc="day.label"/><br/>
                                    <span t-esc="day.date"/>
                                </th>
                            </t>
                            <th class="o_napta_ts_totalhead">TOTAL<br/>SEMAINE</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.personalDayRows" t-as="row" t-key="row.key">
                            <td class="o_napta_ts_projectcell">
                                <span t-esc="row.project"/>
                            </td>
                            <t t-foreach="row.cells" t-as="cell" t-key="cell_index">
                                <td t-att-class="cellClass(cell)">
                                    <div class="o_napta_ts_daycell_wrap">
                                        <input type="text" class="o_napta_ts_cell_input"
                                               t-att-value="cell.value"
                                               t-att-disabled="isCellLocked(cell) ? 'disabled' : undefined"
                                               t-on-input="(ev) => this.onDayCellInput(cell, ev)"/>
                                        <span class="o_napta_ts_cell_unit">d</span>
                                        <i t-attf-class="fa fa-comment{{ cell.comment ? '' : '-o' }} o_napta_ts_comment_icon"
                                           t-att-data-tooltip="cell.comment || 'Ajouter un commentaire'"
                                           t-on-click="(ev) => this.toggleComment(row, cell_index, ev)"/>
                                    </div>
                                    <div t-if="isCommentOpen(row, cell_index)" class="o_napta_ts_comment_pop" t-on-click.stop="">
                                        <textarea class="o_napta_ts_comment_textarea" rows="3" placeholder="Commentaire sur cette journée…"
                                                  t-att-value="cell.comment" t-on-input="(ev) => this.onCommentInput(cell, ev)"/>
                                        <button class="btn btn-sm o_napta_btn_save" t-on-click="closeComment">OK</button>
                                    </div>
                                </td>
                            </t>
                            <td class="o_napta_ts_totalcell">
                                <span t-esc="dayRowTotal(row)"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>

            <!-- ================================ VUE ÉQUIPE ================================ -->
            <t t-if="state.tab === 'team'">

                <div class="o_napta_ts_period_row">
                    <span class="o_napta_ts_period" t-if="state.teamPeriodMode === 'month'">Juillet 2026 du 22/06/26 au 26/07/26</span>
                    <span class="o_napta_ts_period" t-else="">W23 du 01/06/26 au 07/06/26</span>
                    <div class="o_napta_ts_periodmode">
                        <span t-att-class="{ o_napta_ts_periodmode_item: true, o_napta_ts_periodmode_active: state.teamPeriodMode === 'month' }"
                              t-on-click="() => this.setTeamPeriodMode('month')">Mois</span>
                        <span t-att-class="{ o_napta_ts_periodmode_item: true, o_napta_ts_periodmode_active: state.teamPeriodMode === 'week' }"
                              t-on-click="() => this.setTeamPeriodMode('week')">Semaine</span>
                    </div>
                </div>

                <div class="o_napta_ts_toolbar">
                    <div class="o_napta_dropdown_wrap">
                        <button class="btn btn-sm o_napta_toolbar_btn" t-on-click="(ev) => this.toggleTeamMenu('filter', ev)">
                            <i class="fa fa-filter"/> Filtrer
                        </button>
                        <div t-if="state.teamMenuOpen === 'filter'" class="o_napta_ts_dropdown" t-on-click.stop="">
                            <t t-foreach="teamFilterItems" t-as="item" t-key="item">
                                <div class="o_napta_ts_dropdown_item">
                                    <i class="fa fa-star-o"/> <span t-esc="item"/>
                                </div>
                            </t>
                            <div class="o_napta_ts_dropdown_item o_napta_ts_dropdown_item_muted">
                                <i class="fa fa-list"/> Listes déroulantes personnalisées (Utilisateur)
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-sm o_napta_toolbar_btn" disabled="disabled">
                        <i class="fa fa-bookmark-o"/> Sauvegarder la vue
                    </button>
                    <span class="o_napta_badge_filter">Personne (3) <i class="fa fa-times"/></span>
                    <button class="btn btn-sm o_napta_toolbar_btn" disabled="disabled">Réinitialiser</button>
                    <div class="o_napta_ts_toolbar_spacer"/>
                    <button class="btn btn-sm o_napta_toolbar_btn" disabled="disabled">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <button class="btn btn-sm o_napta_toolbar_btn" disabled="disabled">
                        <t t-esc="state.teamPeriodMode === 'month' ? 'Ce mois' : 'Cette semaine'"/>
                    </button>
                    <button class="btn btn-sm o_napta_toolbar_btn" disabled="disabled">
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>

                <!-- Bandeau de sélection de masse : Approuver / Rouvrir -->
                <div t-if="selectedCount and state.teamPeriodMode === 'month'" class="o_napta_ts_bulkbar">
                    <i class="fa fa-minus-square o_napta_ts_bulkbar_icon" t-on-click="() => this.state.selected = {}"/>
                    <span><t t-esc="selectedCount"/> ligne(s) sélectionnée(s)</span>
                    <button class="btn btn-sm o_napta_ts_bulkbar_approve" t-on-click="bulkApprove">
                        <i class="fa fa-check"/> Approuver
                    </button>
                    <button class="btn btn-sm o_napta_ts_bulkbar_reopen" t-on-click="bulkReopen">
                        <i class="fa fa-lock"/> Rouvrir
                    </button>
                </div>

                <!-- ===== Mode Mois (colonnes Semaine) ===== -->
                <table t-if="state.teamPeriodMode === 'month'" class="o_napta_ts_table o_napta_ts_team_table">
                    <thead>
                        <tr>
                            <th class="o_napta_ts_team_head">
                                <input type="checkbox" disabled="disabled"/>
                                <i t-att-class="'fa ' + (state.allExpanded ? 'fa-chevron-up' : 'fa-chevron-down')"
                                   class="o_napta_ts_expandall" t-on-click="() => this.toggleExpandAll()"/>
                                PERSONNE
                            </th>
                            <t t-foreach="teamMonthWeeks" t-as="week" t-key="week.key">
                                <th class="o_napta_ts_weekhead">
                                    <span t-esc="week.label"/><br/>
                                    <span t-esc="week.range"/>
                                </th>
                            </t>
                            <th class="o_napta_ts_totalhead">TOTAL<br/>JUILLET 2026</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.team" t-as="person" t-key="person.id">
                            <tr class="o_napta_ts_person_row">
                                <td class="o_napta_ts_team_head">
                                    <input type="checkbox" t-att-checked="isSelected(person)"
                                           t-on-click="(ev) => this.toggleSelect(person, ev)"/>
                                    <span class="o_napta_ts_avatar" t-esc="initials(person.name)"/>
                                    <span class="o_napta_ts_person_name" t-esc="person.name"/>
                                </td>
                                <t t-foreach="person.monthCells" t-as="cell" t-key="cell_index">
                                    <td t-att-class="cellClass(cell)">
                                        <span t-esc="cellDays(cell)"/>
                                        <i t-if="cell.movement === 'down'" class="fa fa-arrow-down o_napta_ts_movement" t-att-title="movementTooltip"/>
                                        <i t-if="cell.movement === 'up'" class="fa fa-arrow-up o_napta_ts_movement" t-att-title="movementTooltip"/>
                                    </td>
                                </t>
                                <td class="o_napta_ts_totalcell" t-esc="rowTotal({ cells: person.monthCells })"/>
                            </tr>

                            <!-- Actions par semaine : Validated / Approve / Save, uniquement pour la ligne sélectionnée -->
                            <tr t-if="isSelected(person)" class="o_napta_ts_weekactions_row">
                                <td/>
                                <t t-foreach="person.monthCells" t-as="cell" t-key="cell_index">
                                    <td class="o_napta_ts_actioncell">
                                        <span t-if="weekActionKind(cell) === 'locked'" class="o_napta_ts_weekstatus">
                                            <i class="fa fa-lock"/> Validated
                                        </span>
                                        <button t-if="weekActionKind(cell) === 'approve'" class="btn btn-sm o_napta_btn_submit"
                                                t-on-click="() => this.approveCell(cell)">Approve</button>
                                        <button t-if="weekActionKind(cell) === 'save'" class="btn btn-sm o_napta_btn_save"
                                                t-on-click="() => this.saveCell(cell)">Save</button>
                                    </td>
                                </t>
                                <td/>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- ===== Mode Semaine (colonnes Jour) ===== -->
                <table t-if="state.teamPeriodMode === 'week'" class="o_napta_ts_table o_napta_ts_team_table">
                    <thead>
                        <tr>
                            <th class="o_napta_ts_team_head">
                                <input type="checkbox" disabled="disabled"/>
                                <i t-att-class="'fa ' + (state.allExpanded ? 'fa-chevron-up' : 'fa-chevron-down')"
                                   class="o_napta_ts_expandall" t-on-click="() => this.toggleExpandAll()"/>
                                PERSONNE / PROJET
                            </th>
                            <t t-foreach="teamDays" t-as="day" t-key="day.key">
                                <th class="o_napta_ts_weekhead">
                                    <span t-esc="day.label"/><br/>
                                    <span t-esc="day.date"/>
                                </th>
                            </t>
                            <th class="o_napta_ts_totalhead">TOTAL<br/>W23 - JUIN 2026</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.team" t-as="person" t-key="person.id">
                            <tr class="o_napta_ts_person_row">
                                <td class="o_napta_ts_team_head">
                                    <input type="checkbox" t-att-checked="isSelected(person)"
                                           t-on-click="(ev) => this.toggleSelect(person, ev)"/>
                                    <i t-att-class="'fa ' + (isExpanded(person) ? 'fa-chevron-up' : 'fa-chevron-down')"
                                       class="o_napta_ts_expand" t-on-click="() => this.toggleExpand(person)"/>
                                    <span class="o_napta_ts_avatar" t-esc="initials(person.name)"/>
                                    <span class="o_napta_ts_person_name" t-esc="person.name"/>
                                </td>
                                <t t-foreach="person.totalByDay" t-as="d" t-key="d_index">
                                    <td class="o_napta_ts_daytotal" t-esc="d"/>
                                </t>
                                <td class="o_napta_ts_totalcell" t-esc="person.total"/>
                            </tr>

                            <t t-if="isExpanded(person)">
                                <tr t-foreach="person.projects" t-as="proj" t-key="proj.name" class="o_napta_ts_project_row">
                                    <td class="o_napta_ts_team_projectcell">
                                        <span t-esc="proj.name"/>
                                        <div class="o_napta_ts_gauge_wrap" t-att-data-tooltip="proj.gauge.tooltip">
                                            <div class="o_napta_ts_gauge_track">
                                                <div t-attf-class="o_napta_ts_gauge_fill o_napta_ts_gauge_{{proj.gauge.color}}"
                                                     t-attf-style="width: {{proj.gauge.percent}}%"/>
                                            </div>
                                            <span class="o_napta_ts_gauge_label">
                                                <t t-if="proj.gaugeNote" t-esc="proj.gaugeNote"/>
                                                <t t-else="" t-esc="proj.gauge.real + ' / ' + proj.gauge.planned + 'd'"/>
                                            </span>
                                        </div>
                                    </td>
                                    <t t-foreach="proj.values" t-as="v" t-key="v_index">
                                        <td class="o_napta_ts_daytotal" t-esc="v"/>
                                    </t>
                                    <td class="o_napta_ts_totalcell" t-esc="proj.total"/>
                                </tr>
                                <tr class="o_napta_ts_availability_row">
                                    <td>
                                        Disponibilité <i class="fa fa-info-circle o_napta_ts_info" title="Disponibilité calculée à partir des temps déclarés."/>
                                    </td>
                                    <t t-foreach="person.availability" t-as="a" t-key="a_index">
                                        <td class="o_napta_ts_availabilitycell" t-esc="a"/>
                                    </t>
                                    <td class="o_napta_ts_totalcell" t-esc="person.availabilityTotal"/>
                                </tr>
                                <tr class="o_napta_ts_addproject_row">
                                    <td colspan="9">
                                        <button class="btn btn-link o_napta_ts_addproject" disabled="disabled">
                                            <i class="fa fa-plus"/> Ajouter un projet
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
            </t>

            <!-- Légende des statuts, commune aux deux vues -->
            <div class="o_napta_ts_legend">
                <t t-foreach="statusLegend" t-as="item" t-key="item.key">
                    <span class="o_napta_ts_legend_item">
                        <span t-attf-class="o_napta_ts_legend_swatch o_napta_ts_status_{{item.key}}"/>
                        <t t-esc="item.label"/>
                        <i class="fa fa-info-circle o_napta_ts_info" t-att-title="item.tooltip"/>
                    </span>
                </t>
                <span class="o_napta_ts_legend_item">
                    <i class="fa fa-arrow-up o_napta_ts_movement"/><i class="fa fa-arrow-down o_napta_ts_movement"/>
                    Écarts de saisie
                    <i class="fa fa-info-circle o_napta_ts_info" t-att-title="movementTooltip"/>
                </span>
            </div>
        </div>
    </t>

</templates>
