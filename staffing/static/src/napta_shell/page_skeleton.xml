<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="staffing.PageSkeleton">
        <div class="o_napta_page">
            <div class="o_napta_page_header">
                <div class="o_napta_breadcrumb" t-esc="props.page.groupLabel + ' / ' + props.page.label"/>
                <h1 t-esc="props.page.label"/>
                <p class="o_napta_page_subtitle" t-esc="props.page.subtitle"/>
            </div>

            <div t-if="props.page.tabs" class="o_napta_tabs">
                <t t-foreach="props.page.tabs" t-as="tab" t-key="tab">
                    <div t-att-class="{ o_napta_tab: true, o_napta_tab_active: tab === state.activeTab }"
                         t-on-click="() => this.setTab(tab)">
                        <span t-esc="tab"/>
                    </div>
                </t>
            </div>

            <div class="o_napta_toolbar">
                <button class="btn btn-sm o_napta_toolbar_btn" disabled="disabled">
                    <i class="fa fa-bookmark-o"/> Vues
                </button>
                <button class="btn btn-sm o_napta_toolbar_btn" disabled="disabled">
                    <i class="fa fa-filter"/> Filtrer
                </button>
            </div>

            <div class="o_napta_page_body">

                <!-- TABLE -->
                <table t-if="props.page.layout === 'table'" class="o_napta_table">
                    <thead>
                        <tr>
                            <t t-foreach="data.columns" t-as="col" t-key="col.key">
                                <th t-esc="col.label"/>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="data.rows" t-as="row" t-key="row_index">
                            <t t-foreach="data.columns" t-as="col" t-key="col.key">
                                <td t-esc="row[col.key]"/>
                            </t>
                        </tr>
                    </tbody>
                </table>

                <!-- CARDS (kanban) -->
                <div t-if="props.page.layout === 'cards'" class="o_napta_cards_board">
                    <div t-foreach="data.columns" t-as="column" t-key="column.key" class="o_napta_cards_column">
                        <div class="o_napta_cards_column_title" t-esc="column.title"/>
                        <t t-foreach="cardsForColumn(column.key)" t-as="card" t-key="card_index">
                            <div class="o_napta_card">
                                <div class="o_napta_card_title" t-esc="card.title"/>
                                <div class="o_napta_card_client" t-esc="card.client"/>
                                <div t-if="card.dates" class="o_napta_card_dates" t-esc="card.dates"/>
                                <div t-if="card.tags.length" class="o_napta_card_tags">
                                    <span t-foreach="card.tags" t-as="tag" t-key="tag" class="o_napta_card_tag" t-esc="tag"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- CHART (barres) -->
                <div t-if="props.page.layout === 'chart'" class="o_napta_chart"
                     t-att-class="data.horizontal ? 'o_napta_chart_horizontal' : 'o_napta_chart_vertical'">
                    <t t-foreach="data.points" t-as="point" t-key="point.label">
                        <div class="o_napta_bar_row">
                            <span class="o_napta_bar_label" t-esc="point.label"/>
                            <div class="o_napta_bar_track">
                                <div t-if="data.horizontal" class="o_napta_bar_fill_h"
                                     t-attf-style="width: {{ barWidth(point.value) }}"/>
                                <div t-else="" class="o_napta_bar_fill_v"
                                     t-attf-style="height: {{ barHeight(point.value) }}"/>
                            </div>
                            <span class="o_napta_bar_value" t-esc="point.value + (data.unit ? ' ' + data.unit : '')"/>
                        </div>
                    </t>
                </div>

                <!-- CALENDAR (personnes x colonnes temporelles) -->
                <table t-if="props.page.layout === 'calendar'" class="o_napta_table o_napta_calendar">
                    <thead>
                        <tr>
                            <th>Personne</th>
                            <t t-foreach="data.weeks || data.days" t-as="col" t-key="col">
                                <th t-esc="col"/>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="data.people || data.projects" t-as="row" t-key="row">
                            <td t-esc="row"/>
                            <t t-foreach="data.weeks || data.days" t-as="col" t-key="col">
                                <td class="o_napta_calendar_cell"/>
                            </t>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </t>

</templates>
