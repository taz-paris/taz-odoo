<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="staffing.NaptaShell">
        <div class="o_napta_shell">
            <NaptaSidebar activeKey="state.activeKey" onSelect="(key) => this.onSelect(key)"/>
            <main class="o_napta_content">
                <t t-if="activePage" t-component="activeComponent" t-key="state.activeKey" page="activePage"/>
            </main>
        </div>
    </t>

</templates>
