<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Action racine : ouvre la page Projets par défaut (napta_page non précisé). -->
        <record id="napta_shell_action" model="ir.actions.client">
            <field name="name">Napta UI</field>
            <field name="tag">staffing.napta_shell_action</field>
        </record>

        <menuitem name="Napta UI"
                  id="napta_shell_root"
                  action="napta_shell_action"
                  sequence="5"
                  groups="base.group_system"/>

