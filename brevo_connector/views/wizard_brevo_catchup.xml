<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="wizard_brevo_catchup_form">
            <field name="name">Assistant de rattrapage des événements Brevo</field>
            <field name="model">wizard_brevo_catchup</field>
            <field name="arch" type="xml">
                <form>
                    <p>
                        Relit chez Brevo les bounces, adresses bloquées, plaintes spam et désinscriptions de la période choisie,
                        et les applique dans TazForce. Un rattrapage automatique des 3 derniers jours a lieu chaque nuit :
                        cet assistant sert après un arrêt de TazForce de plus de 3 jours, ou pour reprendre l'historique
                        (90 jours maximum, au-delà les événements ne sont plus récupérables chez Brevo).
                    </p>
                    <group>
                        <field name="days"/>
                    </group>
                    <footer>
                        <button name="action_catchup" string="Lancer le rattrapage" type="object" class="btn-primary"/>
                        <button special="cancel" string="Annuler"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="launch_wizard_brevo_catchup" model="ir.actions.act_window">
            <field name="name">Rattrapage Brevo</field>
            <field name="res_model">wizard_brevo_catchup</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem name="Rattrapage Brevo" id="menu_wizard_brevo_catchup" parent="mass_mailing.mass_mailing_configuration" action="launch_wizard_brevo_catchup" groups="base.group_system" sequence="100"/>
    </data>
</odoo>
