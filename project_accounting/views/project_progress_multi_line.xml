<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="project_progess_list_multi_line" model="ir.ui.view">
        <field name="name">project.progress.list.multi.line</field>
        <field name="model">project.progress</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list js_class="list_multi_line" editable="top" expand="1" open_form_view="1">
                <field name="company_id" invisible="1" groups="base.group_multi_company" options="{'no_create': True}" readonly="1"/>
                <field name="currency_id" invisible="1"/>
                <group col="3">
                    <group>
                        <field name="rel_project_id"/>
                    </group>
                    <group>
                        <field name="rel_closing_date"/>
                    </group>
                    <group>
                        <field name="type"/>
                    </group>
                </group>
                    <group col="4">
                        <group name="previous_data" string="Rappel données précédente clôture">
                            <field name="rel_previous_progress_rate" widget="percentage"/>
                            <field name="rel_previous_progress_cost_amount"/>
                            <field name="rel_previous_progress_revenue_amount"/>
                        </group>
                        <group name="valuation" string="Valorisation totale à date de clôture">
                            <field name="outsourcing_product_qty" invisible="type == 'internal_production'" sum="Total product qty"/>
                            <field name="progress_rate" widget="percentage" readonly="is_validated"/>
                            <field name="progress_cost_amount" sum="Total Cost"/>
                            <field name="progress_revenue_amount" sum="Total Revenue"/>
                        </group>
                        <group name="valuation_period" string="Valorisation de la période">
                            <field name="outsourcing_product_qty_period" invisible="type == 'internal_production'" sum="Total product qty"/>
                            <field name="progress_rate_period" widget="percentage"/>
                            <field name="progress_cost_amount_period" sum="Total Cost"/>
                            <field name="progress_revenue_amount_period" sum="Total Revenue"/>
                        </group>
                        <group name="target" string="Projection à terminaison">
                            <newline/><newline/>
                            <field name="target_project_outsourcing_product_qty" invisible="type == 'internal_production'" sum="Total product qty"/>
                            <field name="target_project_cost" sum="Total Cost"/>
                            <field name="target_project_revenue" sum="Total Revenue"/>
                        </group>
                    </group>
            </list>
        </field>
    </record>

    <!-- Mise à jour de l'action pour utiliser cette vue en premier -->
    <record id="project_progress_action" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="project_progess_list_multi_line"/>
        <field name="context">{}</field>
    </record>
</odoo>
