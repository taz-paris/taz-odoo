<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="project_progess_list_multi_line" model="ir.ui.view">
        <field name="name">project.progress.list.multi.line</field>
        <field name="model">project.progress</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list js_class="list_multi_line" editable="top" expand="1" open_form_view="1">
                   <group>
                        <group name="info_base" string="Informations de base">
                            <field name="rel_project_id"/>
                            <field name="accounting_closing_id" readonly="1"/>
                            <field name="rel_closing_date"/>
                            <field name="type"/>
                            <field name="outsourcing_link_id" readonly="1" invisible="not outsourcing_link_id"/>
                        </group>
                        <group name="responsibles" string="Responsables &amp; Société">
                            <field name="rel_project_user_id"/>
                            <field name="rel_project_manager_user_id"/>
                            <field name="rel_outsourcing_partner_id" invisible="type == 'internal_production'"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group name="progress_valuation" string="Suivi d'avancement et Valorisation" col="3">
                        <group name="calculation" string="Saisie de l'avancement">
                            <field name="progress_rate" widget="percentage" readonly="is_validated"/>
                            <field name="target_project_cost"/>
                            <field name="target_project_revenue"/>
                        </group>
                        <group name="valuation" string="Valorisation">
                            <field name="progress_cost_amount" sum="Total Cost"/>
                            <field name="progress_revenue_amount" sum="Total Revenue"/>
                            <field name="progress_cost_amount_period"/>
                            <field name="progress_revenue_amount_period"/>
                        </group>
                        <group name="previous_data" string="Données précédentes">
                            <field name="previous_progress_id"/>
                            <field name="rel_previous_progress_rate" widget="percentage"/>
                            <field name="rel_previous_progress_cost_amount"/>
                            <field name="rel_previous_progress_revenue_amount"/>
                        </group>
                    </group>
                
                <!-- Champs cachés pour calculs/totaux si besoin -->
                <field name="currency_id" column_invisible="True"/>

            </list>
        </field>
    </record>

    <!-- Mise à jour de l'action pour utiliser cette vue en premier -->
    <record id="project_progress_action" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="project_progess_list_multi_line"/>
        <field name="context">{}</field>
    </record>
</odoo>
