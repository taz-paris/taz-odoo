<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="project_progess_list" model="ir.ui.view">
        <field name="name">project.progress.list</field>
        <field name="model">project.progress</field>
        <field name="arch" type="xml">
            <list string="Avancements" expand="1">
                <field name="company_id" optional="hide" groups="base.group_multi_company" options="{'no_create': True, 'no_open': True}"/>
                <field name="rel_project_id"/>
                <field name="accounting_closing_id" optional="hide"/>
                <field name="rel_closing_date"/>
                <field name="rel_original_stage_id" optional="show"/>
                <field name="rel_outsourcing_partner_id" optional="show"/>
                <field name="type"/>
                <field name="outsourcing_link_id" readonly="1" optional="hide"/>
                <field name="previous_progress_id" optional="hide"/>
                <field name="rel_previous_progress_revenue_rate" optional="show" widget="percentage"/>
                <field name="rel_previous_progress_cost_amount" optional="hide"/>
                <field name="rel_previous_progress_revenue_amount" optional="hide"/>
                <field name="progress_revenue_rate"/>
                <field name="target_project_cost" optional="show" sum="Total Cost"/>
                <field name="target_project_revenue" optional="show" sum="Total Revenue"/>
                <field name="progress_cost_amount" optional="show" sum="Total Cost"/>
                <field name="progress_revenue_amount" optional="show" sum="Total Revenue"/>
                <field name="progress_cost_amount_period" optional="show" sum="Total Cost Period"/>
                <field name="progress_revenue_amount_period" optional="show" sum="Total Revenue Period"/>
                <field name="is_validated" widget="boolean_toggle"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_project_progress_form" model="ir.ui.view">
        <field name="name">project.progress.form</field>
        <field name="model">project.progress</field>
        <field name="arch" type="xml">
            <form string="Avancement" readonly="is_validated or type == 'other'">
                <header>
                    <field name="is_validated" invisible="1"/>
                    <button name="action_validate" string="✓ Valider" type="object" invisible="is_validated" class="btn-primary"/>
                    <button name="action_invalidate" string="Dévalider" type="object" invisible="not is_validated" class="btn-outline-danger"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group col="3">
                        <group name="info_base" string="Informations de base">
                            <field name="rel_project_id" readonly="1"/>
                            <field name="accounting_closing_id" readonly="1"/>
                            <field name="rel_closing_date" readonly="1"/>
                            <field name="rel_original_stage_id" readonly="1"/>
                            <field name="type" readonly="1"/>
                            <field name="outsourcing_link_id" readonly="1" invisible="not outsourcing_link_id"/>
                        </group>
                        <group name="responsibles" string="Responsables &amp; Société">
                            <field name="rel_project_user_id" readonly="is_validated"/>
                            <field name="rel_project_manager_user_id" readonly="is_validated"/>
                            <field name="rel_outsourcing_partner_id" invisible="type == 'internal_production'" readonly="is_validated"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="previous_progress_id" readonly="is_validated"/>
                        </group>
                    </group>
                    <group col="4">
                        <group colspan="1">
                            <field name="rel_original_stage_id" readonly="1"/>
                        </group>
                        <group colspan="1">
                            <field name="rel_outsourcing_partner_id" invisible="type == 'internal_production'"/>
                            <button type="object" name="goto_napta" string="Voir sur Napta"
                                    class="btn btn-outline-secondary" icon="fa-external-link"
                                    invisible="type != 'internal_production'"/>
                        </group>
                        <group colspan="2">
                            <field name="comment"/>
                        </group>
                    </group>
                    <group col="4">
                        <group name="previous_data" string="Rappel données fin de période précédente">
			    <field name="previous_progress_id"/>
                            <field name="rel_previous_progress_cost_amount"/>
                            <field name="rel_previous_progress_revenue_rate" widget="percentage"/>
                            <field name="rel_previous_progress_revenue_amount"/>
                            <field name="rel_previous_progress_comment"/>
                        </group>
                        <!-- Bloc pour la production interne (avec style bleu) -->
                        <group name="valuation_internal" string="Valorisation totale fin de période" 
                                style="background-color:#abdbff;" 
                                invisible="type != 'internal_production'">
                            <field name="progress_cost_amount"/>
                            <field name="progress_revenue_rate" widget="percentage" readonly="is_validated"/>
                            <field name="progress_revenue_amount" readonly="is_validated"/>
                            <field name="progress_revenue_margin" decoration-danger="progress_revenue_margin &lt; 0"/>
                            <field name="progress_revenue_margin_rate" widget="percentage" decoration-danger="progress_revenue_margin_rate &lt; 0"/>
                        </group>
                        <!-- Bloc pour les autres types (sans style) -->
                        <group name="valuation_other" string="Valorisation totale fin de période"
                                style="background-color:none;"
                                invisible="type == 'internal_production'">
                            <field name="outsourcing_product_qty" readonly="1"/>
                            <field name="progress_cost_amount"/>
                            <field name="progress_revenue_rate" widget="percentage" readonly="1"/>
                            <field name="progress_revenue_amount" readonly="1"/>
                            <field name="progress_revenue_margin" decoration-danger="progress_revenue_margin &lt; 0"/>
                            <field name="progress_revenue_margin_rate" widget="percentage" decoration-danger="progress_revenue_margin_rate &lt; 0"/>
                        </group>
                        <!-- Bloc Période pour la production interne (avec style bleu) -->
                        <group name="valuation_period_internal" string="Valorisation de la période" 
                                style="background-color:none;"
                                invisible="type != 'internal_production'">
                            <field name="progress_cost_amount_period"/>
                            <field name="progress_revenue_rate_period" widget="percentage" readonly="1"/>
                            <field name="progress_revenue_amount_period"/>
                        </group>
                        <!-- Bloc Période pour les autres types (sans style) -->
                        <group name="valuation_period_other" string="Valorisation de la période" 
                                style="background-color:#abdbff;" 
                                invisible="type == 'internal_production'">
                            <field name="outsourcing_product_qty_period" readonly="is_validated or type == 'other'"/>
                            <field name="progress_cost_amount_period" sum="Total Cost Period"/>
                            <field name="progress_revenue_rate_period" widget="percentage" readonly="is_validated or type == 'other'"/>
                            <field name="progress_revenue_amount_period" sum="Total Revenue Period"/>
                        </group>
                        <group name="target" string="Projection à terminaison">
                            <newline/><newline/>
                            <field name="target_project_outsourcing_product_qty" invisible="type == 'internal_production'"/>
                            <field name="target_project_cost" readonly="type != 'internal_production'"/>
                            <field name="future_staffing_days" invisible="type != 'internal_production'"/>
                            <field name="price_unit" invisible="type in ['internal_production', 'other']"/>
                            <field name="target_project_revenue" />
                            <field name="reselling_price_unit" invisible="type in ['internal_production', 'other']"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_project_progress_search" model="ir.ui.view">
        <field name="name">project.progress.search</field>
        <field name="model">project.progress</field>
        <field name="arch" type="xml">
            <search string="Recherche Avancements">
                <field name="rel_project_id"/>
                <separator/>
                <filter string="Date de clôture" name="closing_date_filter" date="rel_closing_date"/>
                <separator/>
                <filter string="Mes avancements" name="my_progress" domain="['|', ('rel_project_user_id', '=', uid), ('rel_project_manager_user_id', '=', uid)]"/>
                <separator/>
                <filter string="Avancement du mois M-1" name="prev_month" 
                        domain="[('rel_closing_date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01')), 
                                 ('rel_closing_date', '&lt;', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Projet en cours" name="launched_projects" domain="[('rel_original_stage_id.state', '=', 'launched')]"/>
                <separator/>
                <filter string="Validé" name="validated" domain="[('is_validated', '=', True)]"/>
                <filter string="Non validé" name="not_validated" domain="[('is_validated', '=', False)]"/>
                <separator/>
                <filter string="Production interne" name="internal" domain="[('type', '=', 'internal_production')]"/>
                <filter string="Sous-traitance" name="outsourcing" domain="[('type', 'in', ('outsourcing', 'cosourcing'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Projet" name="group_by_project" context="{'group_by': 'rel_project_id'}"/>
                    <filter string="Statut début clôture" name="group_by_stage" context="{'group_by': 'rel_original_stage_id'}"/>
                    <filter string="Clôture" name="group_by_closing" context="{'group_by': 'accounting_closing_id'}"/>
                    <filter string="Type" name="group_by_type" context="{'group_by': 'type'}"/>
                    <filter string="Fournisseur" name="group_by_partner" context="{'group_by': 'rel_outsourcing_partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="project_progress_action" model="ir.actions.act_window">
        <field name="name">Mes avancements M-1</field>
        <field name="res_model">project.progress</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="project_progess_list_multi_line"/>
        <field name="search_view_id" ref="view_project_progress_search"/>
        <field name="context">{'search_default_my_progress': 1, 'search_default_prev_month': 1, 'search_default_launched_projects': 1, 'search_default_group_by_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez un nouvel avancement.
            </p>
        </field>
    </record>

    <menuitem id="project_progress_menu" 
              name="Avancements de la production" 
              parent="project_accounting.project_accounting_closing_menu_root" 
              action="project_progress_action" 
              sequence="20"/>

    <record id="action_recompute_progress" model="ir.actions.server">
        <field name="name">Recalculer les données de cet avancement</field>
        <field name="model_id" ref="model_project_progress"/>
        <field name="binding_model_id" ref="model_project_progress"/>
        <field name="state">code</field>
        <field name="code">for rec in records:
    rec.force_refresh()</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
</odoo>
