<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_recompute_customer_book_goals" model="ir.cron">
            <field name="name">Recalculer les ambitions annuelles de compte (Refresh temporel)</field>
            <field name="model_id" ref="taz-common.model_taz_customer_book_goal"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.search([]).trigger_goals_recompute()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
