<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_grid_view.GridView" owl="1">
        <Layout display="props.display" className="'o_grid_view h-100'">
            <t t-set-slot="layout-actions">
                <SearchBar/>
            </t>
            
            <div class="o_grid_control_panel d-flex justify-content-between p-2 border-bottom flex-0-0-auto">
                <div class="o_grid_buttons d-flex gap-1">
                    <button t-if="!props.archInfo.createInline || (!hasData &amp;&amp; !props.archInfo.displayEmpty)"
                            type="button" class="btn btn-primary o_grid_button_add" t-on-click="onAddLine">
                        Add a line
                    </button>
                    <div class="o_grid_range_buttons btn-group">
                        <t t-foreach="props.archInfo.ranges" t-as="range" t-key="range.name">
                            <button type="button" 
                                    class="btn btn-secondary" 
                                    t-att-class="{active: state.currentRange.name === range.name}"
                                    t-on-click="() => this.onRangeSelected(range.name)">
                                <t t-esc="range.string"/>
                            </button>
                        </t>
                    </div>
                </div>
                <div class="o_grid_navigation_buttons btn-group">
                    <button type="button" class="btn btn-secondary" t-on-click="onPrev">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <button type="button" class="btn btn-secondary" t-on-click="onToday">
                        Today
                    </button>
                    <button type="button" class="btn btn-secondary" t-on-click="onNext">
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>
            </div>
            
            <div class="o_grid_content flex-grow-1">
                <t t-if="hasData || props.archInfo.displayEmpty">
                    <GridRenderer 
                        model="model" 
                        rowFields="rowFields"
                        fields="props.fields"
                        archInfo="props.archInfo" 
                        onCellUpdate.bind="onCellUpdate"
                        onToggleRow.bind="onToggleRow"
                        onAddLine.bind="onAddLine"
                    />
                </t>
                <t t-else="">
                    <div class="o_view_nocontent">
                        <div class="o_nocontent_help">
                            <p class="o_view_nocontent_smiling_face">
                                No data available for this period.
                            </p>
                            <p>
                                Click on "Add a line" to start recording.
                            </p>
                        </div>
                    </div>
                </t>
            </div>
        </Layout>
    </t>

    <t t-name="web_grid_view.GridRenderer" owl="1">
        <div class="o_grid_renderer">
            <div class="o_grid_scrollable">
                <table class="table table-bordered table-sm o_grid_table">
                    <thead>
                        <tr>
                            <th class="o_grid_header">Group By</th>
                            <th t-foreach="cols" t-as="col" t-key="col.values[props.archInfo.colField.name]" class="o_grid_header">
                                <div t-att-class="{ 'text-primary fw-bold': col.is_current }">
                                    <t t-esc="col.label"/>
                                </div>
                            </th>
                            <th class="o_grid_total fw-bold o_grid_header">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="rows" t-as="row" t-key="row.stringKey || row_index">
                            <td class="o_grid_row_header" t-att-style="'padding-left: ' + ((row.depth || 0) * 20 + 10) + 'px !important'">
                                <i t-if="!row.isLeaf" 
                                   t-att-class="'fa fa-fw ' + (props.model.expandedRows.has(row.stringKey) ? 'fa-caret-down' : 'fa-caret-right')"
                                   t-on-click="() => props.onToggleRow(row.stringKey)"
                                   style="cursor: pointer; margin-right: 5px;"
                                />
                                <span t-if="row.isLeaf &amp;&amp; row.depth" style="margin-left: 20px;"/>
                                <span t-att-class="{ 'o_grid_clickable_label': this.isMany2one(row) }"
                                      t-on-click="() => this.isMany2one(row) &amp;&amp; this.onLabelClick(row)">
                                    <t t-esc="row.label || row.values[props.rowFields[0].name]"/>
                                </span>
                            </td>
                            <td t-foreach="getRowGrid(row)" t-as="cell" t-key="cell_index" class="o_grid_cell">
                                <input t-if="!row.readonly &amp;&amp; !cell.readonly &amp;&amp; row.isLeaf"
                                       type="text" 
                                       class="o_grid_input form-control form-control-sm text-end" 
                                       t-att-value="formatValue(cell.value)"
                                       t-on-change="(ev) => this.onCellChange(rows.indexOf(row), cell_index, ev)"
                                />
                                <span t-else="" class="d-block text-end pe-2">
                                    <t t-esc="formatValue(cell.value)"/>
                                </span>
                            </td>
                            <td class="o_grid_row_total fw-bold text-end pe-2">
                                <t t-esc="formatValue(row.rowTotal)"/>
                            </td>
                        </tr>
                        <tr t-if="props.archInfo.createInline" class="o_grid_add_line_row">
                            <td class="o_grid_row_header">
                                <button type="button" class="btn btn-link o_grid_add_line" t-on-click="props.onAddLine">
                                    <i class="fa fa-plus me-1"/>Add a line
                                </button>
                            </td>
                            <td t-att-colspan="cols.length + 1"></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="o_grid_total_row fw-bold">
                            <td>Total</td>
                            <td t-foreach="colTotals" t-as="total" t-key="total_index" class="text-end">
                                <t t-esc="formatValue(total)"/>
                            </td>
                            <td class="text-end">
                                <t t-esc="formatValue(grandTotal)"/>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </t>

</templates>
